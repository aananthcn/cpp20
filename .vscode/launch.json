{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Current File (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    // Corrected macOS LLDB Configuration
    {
        "name": "Debug Current File (LLDB - Mac)",
        "type": "lldb",
        "request": "launch",
        "program": "${fileDirname}/${fileBasenameNoExtension}",
        "args": [],
        "cwd": "${fileDirname}",
        "console": "externalTerminal", // <-- Corrected property name
        "env": {}, // <-- Corrected property name (empty object for no environment variables)
        "initCommands": [
            "settings set target.language c++20"
        ],
        "preRunCommands": [
            "breakpoint set --name main" // <-- Replaces stopAtEntry: true
        ],
        "preLaunchTask": "C/C++: clang++ build active file (Mac/Linux)"
    }
  ]
}
