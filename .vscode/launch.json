{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Current File (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    // NEW macOS GDB Configuration with your path
    {
        "name": "Debug Current File (GDB - Mac)",
        "type": "cppdbg",
        "request": "launch",
        // Change to forward slashes and remove the .exe extension
        "program": "${fileDirname}/${fileBasenameNoExtension}", 
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        // Set to true to launch in a separate Terminal window
        "externalConsole": true, 
        "MIMode": "gdb",
        // *** UPDATED PATH FOR APPLE SILICON HOMEBREW ***
        "miDebuggerPath": "/opt/homebrew/bin/gdb", 
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    }
  ]
}
