{
    "version": "2.0.0",
    "tasks": [
        {
            // NEW: Simplified Task for macOS/Linux (uses /usr/bin/g++)
            "type": "shell",
            "label": "C/C++: clang++ build active file (Mac/Linux)",
            "command": "/usr/bin/clang++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-g",
                "${file}",
                "-o",
                // Uses forward slashes and no .exe
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true // Make this the default build task for simplicity on Mac
            },
            "detail": "Compiler: /usr/bin/g++ (Clang on Mac)"
        },
        // Existing Windows Task (to be verified on Windows machine again)
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file (Windows)",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-g",
                "${file}",
                "-o",
                // Uses backslashes and .exe
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger (Windows)."
        }
    ]
}