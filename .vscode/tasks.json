{
	"version": "2.0.0",
	"tasks": [
		{
			// 💡 CHANGED TYPE TO "shell" 💡
			"type": "shell",
			"label": "C/C++: g++ build active file",
			
			// Default command (will be used on macOS/Linux)
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-std=c++20",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: /usr/bin/g++",

			// 💡 WINDOWS OVERRIDE BLOCK 💡
			"windows": {
				// Assuming g++.exe is in the Windows PATH (e.g., MinGW/MSYS2)
				"command": "g++.exe",
				// Use backslashes for path if needed, or stick to forward slashes as it's often more portable
				"args": [
					"-fdiagnostics-color=always",
					"-std=c++20",
					"-g",
					"${file}",
					"-o",
					"${fileDirname}\\${fileBasenameNoExtension}.exe" // Added .exe for Windows output
				],
				"detail": "compiler: g++.exe"
			}
		}
	]
}