{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: Build Active File (Cross-Platform)",
            "type": "shell", // Use 'shell' as the default for Mac/Linux commands
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            // === Default (Mac/Linux Fallback) Configuration ===
            // This runs on Mac/Linux if no specific 'osx' or 'linux' overrides are provided.
            "command": "/usr/bin/clang++", // Use clang++ for Mac default (better)
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-g",
                "${file}",
                "-o",
                // Uses forward slashes and NO .exe extension
                "${fileDirname}/${fileBasenameNoExtension}" 
            ],
            "detail": "Compiler: clang++/g++ (cross-platform)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            
            // === WINDOWS OVERRIDE ===
            // VS Code will use these settings when running on Windows
            "windows": {
                "command": "C:/msys64/mingw64/bin/g++.exe", // Windows compiler path
                "args": [
                    "-fdiagnostics-color=always",
                    "-std=c++20",
                    "-g",
                    "${file}",
                    "-o",
                    // Uses backslashes and the .exe extension
                    "${fileDirname}\\${fileBasenameNoExtension}.exe" 
                ]
            },

            // === LINUX OVERRIDE (Good practice to confirm the compiler) ===
            "linux": {
                "command": "/usr/bin/g++"
                // Inherits all 'args' from the default block above
            },

            // === MACOS OVERRIDE (Optional, since default uses clang++) ===
            "osx": {
                "command": "/usr/bin/clang++"
                // Inherits all 'args' from the default block above
            }
        }
        // The second redundant task has been removed, as it's now covered by the 'windows' override.
    ]
}